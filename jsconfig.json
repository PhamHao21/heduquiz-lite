{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"target": "esnext",
		"module": "esnext",
		"checkJs": true,
		"allowArbitraryExtensions": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.ts", "src/**/*.svelte"]
}
